{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moje-naselje",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"observability": {
		"enabled": true
	},
	/**
	 * Cron Triggers
	 * Runs the Worker automatically every 12 hours (00:00 and 12:00 UTC)
	 */
	"triggers": {
		"crons": ["0 */12 * * *"]
	},
	/**
	 * Environment Variables
	 */
	"vars": {
		"NEWS_RSS_URL": "https://news.google.com/rss/search?q=Beograd+Serbia&hl=sr-Latn&gl=RS&ceid=RS:sr-Latn",
		"BEOGRAD_RS_URL": "https://www.beograd.rs/lat/vesti"
	}
	/**
	 * KV Namespace for article deduplication:
	 * You can bind it directly in the Cloudflare Dashboard under:
	 * Workers & Pages > moje-naselje > Settings > Bindings > Add > KV Namespace (Variable name: NEWS_KV)
	 * OR uncomment below with your real namespace ID:
	 *
	 * "kv_namespaces": [
	 *   {
	 *     "binding": "NEWS_KV",
	 *     "id": "<your-real-kv-id>"
	 *   }
	 * ]
	 */
}
