{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moje-naselje",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"observability": {
		"enabled": true
	},
	// Cron Trigger: Runs automatically every 6 hours (00:00, 06:00, 12:00, 18:00 UTC)
	"triggers": {
		"crons": ["0 */6 * * *"]
	},
	// Environment Variables
	"vars": {
		"NEWS_RSS_URL": "https://news.google.com/rss/search?q=%22vojvode+vlahovica%22+OR+%22vojvode+vlahovi%C4%87a%22+OR+%22vojvode+vlahovi%C4%87%22+OR+%22%D0%B2%D0%BE%D1%98%D0%B2%D0%BE%D0%B4%D0%B5+%D0%B2%D0%BB%D0%B0%D1%85%D0%BE%D0%B2%D0%B8%D1%9B%D0%B0%22+OR+%22%D0%B2%D0%BE%D1%98%D0%B2%D0%BE%D0%B4%D0%B5+%D0%B2%D0%BB%D0%B0%D1%85%D0%BE%D0%B2%D0%B8%D1%9B%22&hl=sr-Latn&gl=RS&ceid=RS:sr-Latn",
		"BEOGRAD_RS_URL": "https://www.beograd.rs/lat/vesti"
	},
	// Migrations: Clean up leftover Durable Object class from previous starter template
	"migrations": [
		{
			"tag": "v2",
			"deleted_classes": ["WorkflowStatusDO"]
		}
	]
}
