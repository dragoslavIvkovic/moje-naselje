{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "moje-naselje",
	"main": "src/index.ts",
	"compatibility_date": "2025-10-08",
	"observability": {
		"enabled": true
	},
	/**
	 * Cron Triggers
	 * Runs the Worker automatically every 12 hours (00:00 and 12:00 UTC)
	 */
	"triggers": {
		"crons": ["0 */12 * * *"]
	},
	/**
	 * Cloudflare KV Namespace for deduplicating published articles
	 * Create one via: npx wrangler kv namespace create NEWS_KV
	 * Replace "REPLACE_WITH_YOUR_KV_NAMESPACE_ID" with the generated ID.
	 */
	"kv_namespaces": [
		{
			"binding": "NEWS_KV",
			"id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
		}
	],
	/**
	 * Environment Variables
	 */
	"vars": {
		"NEWS_RSS_URL": "https://news.google.com/rss/search?q=Beograd+Serbia&hl=sr-Latn&gl=RS&ceid=RS:sr-Latn",
		"BEOGRAD_RS_URL": "https://www.beograd.rs/lat/vesti"
	}
}
